# RevenueCat public SDK keys. Public by design — safe in a shipped bundle — but
# they are PER PLATFORM, and the wrong one silently fails.

# Web Billing key, used by the Vercel deploy (@revenuecat/purchases-js).
# A `test_…` key is SANDBOX: real cards are not charged. Swap it for a live key
# before you rely on revenue.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=test_ieLLyTgPUYgQTHpkkFhhxwPbVQx

# Store key, used by the Android/Galaxy build (react-native-purchases).
# A Galaxy Store build needs the AMAZON/SAMSUNG key — NOT the Google Play one.
EXPO_PUBLIC_REVENUECAT_KEY=

# Dashboard must define an entitlement with the identifier `collegemaps_pro`
# and products `lifetime` and `monthly`. See src/purchases/config.ts.
