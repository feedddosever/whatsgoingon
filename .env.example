# RevenueCat PUBLIC SDK key. Safe to ship in the bundle — it is the public key,
# not a secret. But it is PER STORE: a Galaxy Store build needs the Amazon/
# Samsung key, not the Google Play one.
#
# Without this the app still runs end to end; the paywall simply reports that
# purchases are unavailable. Everything except buying works.
EXPO_PUBLIC_REVENUECAT_KEY=
